[Unit]
# Background Jupyter kernel for the daharness tool framework
# (`tool_repl.py --kernel`): the framework namespace in user_ns, attachable
# from any local Jupyter frontend. See tool_repl.py:_launch_kernel.
Description=daharness tool kernel (tool_repl.py --kernel)
Documentation=file:///home/kali/github/daharness/AGENTS.md
# Kernel startup is self-contained (tool discovery + namespace build); the
# network matters to the tools the kernel runs, not to booting it.
After=network.target

[Service]
Type=simple
# Root: raw sockets, MSF, ZAP. The kernel itself redirects
# JUPYTER_RUNTIME_DIR and chowns the connection file to the checkout owner
# so the desktop user's IDEs can attach — see _kernel_owner() in tool_repl.py.
User=root
Group=root
WorkingDirectory=/home/kali/github/daharness
# No tty under systemd: the kernel arms the SIGTERM/shutdown_request path
# (not the double-Ctrl-C tty exit).
StandardInput=null
ExecStart=/home/kali/github/daharness/venv/bin/python /home/kali/github/daharness/tool_repl.py --kernel

# The kernel banners the connection-file path + attach command to stderr
# before ipykernel swaps the streams; journald is the only place to read it:
#   journalctl -u daharness-kernel -f
StandardOutput=journal
StandardError=journal

# Framework background jobs (nmap/masscan/ffuf/...) spawn detached
# (start_new_session=True) so orphaned scans survive harness death; killing
# only the main process on stop preserves that semantic.
KillMode=process

# SIGTERM unwinds ipykernel cleanly (exit 0, connection file removed);
# restart on crashes only, not on intentional stops.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target