[Unit]
# Background service for the full daharness stack:
# Brain, ZAP, Metasploit MCP, and the API gateway.
Description=daharness security framework services (bootstrap.py --daemon)
Documentation=file:///home/kali/github/daharness/AGENTS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: raw sockets, MSF, ZAP, and the framework's privileged security tools.
# bootstrap.py loads /home/kali/github/daharness/.env before starting services.
User=root
Group=root
WorkingDirectory=/home/kali/github/daharness
StandardInput=null
ExecStart=/home/kali/github/daharness/venv/bin/python /home/kali/github/daharness/bootstrap.py --daemon

# bootstrap.py handles SIGTERM, gracefully stops the API, and reaps its
# sidecars. Keep systemd from killing those children before that cleanup runs.
KillMode=process
StandardOutput=journal
StandardError=journal
SyslogIdentifier=daharness

# Restart after an unexpected crash, but not after an intentional stop.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
