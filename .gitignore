# --- bytecode / build artifacts ---
__pycache__/
*.pyc
*.pyo
*.so
*.exe
# deb packaging intermediates
debian/.debhelper/
debian/daharness/
debian/files
debian/debhelper-build-stamp
*.debhelper.log
*.substvars
debian/daharness.*.debhelper

# --- runtime state / local data (deliberately untracked) ---
ids.db
*.sqlite3
*.db
*.memory/
chroma-data/
# --- Brain sidecar socket + lock dir (see constants.brain_socket_path) ---
/run/
.zap_home/
.pw-browsers/
findings_md/
scope/
*.scope
# --- drop folders (operator payloads & evidence, tracked README only) ---
/binaries/*
!/binaries/.gitkeep
!/binaries/README.md
/apk/*
!/apk/.gitkeep
!/apk/README.md
/dropbox/*
!/dropbox/.gitkeep
!/dropbox/README.md
# --- packet captures (scapy wrpcap output; forensic evidence) ---
/pcaps/*
!/pcaps/.gitkeep
!/pcaps/README.md

# --- secrets / env ---
.env
framework.env
*.pem

# --- local scratch / editor droppings ---
WIP_*.*
scratch.*
scratch-data/*
cookie_jar.db*
hydra.restore
*.swp
.*.swp
.vscode/*
!.vscode/settings.json
# Untracked session/terminal litter seen on the operator box
what.txt
tracebackstuff.txt
todo.md

# --- dependency lockfiles ---
# requirements.txt is the tracked canonical pinned dependency freeze.
# The exception un-ignores it so it stays version-controlled.
*.txt
!requirements.txt
# --- generated REPL tool stubs (scripts/gen_repl_stubs.py) ---
framework_tools.pyi
framework_tools.py
.ipynb_checkpoints/