# .env.example
#
# Local configuration template for the Modular Security Framework.
# Copy to .env and fill in the real values. (.env itself is never tracked.)
# -----------------------------------------------------------------------------
# Required / secret:
#   EMBED_URL                   - embeddings endpoint (EMBED_MODEL alongside;
#                                 default http://localhost:11434/api/embed;
#                                 loopback or LAN only — never a cloud API)
#   MSGRPC_PASSWORD             - Metasploit RPC password (secret)
#   GATEWAY_API_KEY             - API key for the framework gateway (unset = unauthenticated dev mode)
#   ZAP_API_KEY                 - ZAP daemon API key (sent as the apikey query param)
#   H1_API_USERNAME / H1_API_TOKEN - HackerOne API (Basic auth)
#   INTIGRITI_USERNAME / INTIGRITI_API_TOKEN - Intigriti platform API
#
# Optional tuning (value shown next to each key = the in-code default):
#   TOOL_BUDGET_PER_TURN        - per-turn tool-call cap per agent/turn on the
#                                 gateway lanes (default 10; 0 = disabled)
#   TOOL_BUDGET_IDLE_RESET_MIN  - rolling-counter reset when turn_key is omitted (default 5)
#   TOOL_BUDGET_TERMINAL_ALLOWLIST - tool_id prefixes still callable past the cap
#                                 (default utils.memory_tools.,utils.findings.)
#   LARGE_MODE_BYTE_CAP         - total serialized bytes at which `large` mode
#                                 field-caps a result + stores the full copy in
#                                 scratch (default 16384 = 16 KiB). The default
#                                 result_mode for every lane (REST/MCP/OWUI).
#                                 `full` is gone — aliased to `large`.
#   LARGE_FIELD_CHAR_CAP        - per-string-field truncation length when the
#                                 byte cap is exceeded (default 4096).
#   BRAIN_DISPATCH_TIMEOUT      - Brain socket dispatch timeout, seconds (default 600)
#   SQLMAP_TIMEOUT              - sqlmap scan wall-clock cap, seconds (default 1800)
#   ROUTER_MAX_DISTANCE         - API-path semantic-match refusal threshold, chromadb L2 on
#                                 nomic-embed-text vectors (default 1.1; lower = stricter refusal)
#   EMBED_MODEL                 - embedding model id sent to the embed endpoint; the single
#                                 knob shared by the tool registry and memory embed lanes
#                                 (default nomic-embed-text; change it, then re-index:
#                                 python -m daharness.core)
#   EMBED_URL                   - full POST target of the embeddings endpoint (default
#                                 http://localhost:11434/api/embed). Provider-agnostic:
#                                 see the Embedding section below for examples.
#                                 EMBED_API_KEY arms Authorization: Bearer for keyed providers.
#   CHROMA_HOST / CHROMA_PORT   - tool registry ChromaDB server (default localhost:9000)
#   MCP_ENDPOINT                - Metasploit MCP sidecar (default http://127.0.0.1:55553)
#   MSF_RPC_PORT                - Metasploit RPC port (default 55553)
#   BRAIN_SCAN_DIRS             - Brain startup scan dirs (default auxiliaries,listeners,payloads)
#   BRAIN_SOCKET                - Brain sidecar UDS path (default <checkout>/run/brain.sock).
#                                 Lives inside the tree so bind-mounted container lanes
#                                 (jupyter kernel, open-terminal) reach the SAME socket as
#                                 the host; only override for a lane running its own sidecar.
#                                 Do not point it at /tmp if you use the container lanes.
#                                 A writable dev checkout that should talk to the
#                                 OS-packaged sidecar sets it in .env — desktop
#                                 VS Code kernels never source /etc/profile.d.
#   DAHARNESS_KERNEL_OWNER      - user to chown root-spawned kernel artifacts to
#                                (name or uid; default SUDO_UID, else checkout
#                                owner). Applies to --kernel / --install-kernelspec.
#   ZAP_HOST / ZAP_PORT         - ZAP daemon API (default 127.0.0.1 / 8090)
#   ZAP_PROXY_BIND              - ZAP browser-proxy bind (default 0.0.0.0; API ACL stays loopback)
#   ZAP_XMX                     - ZAP daemon JVM heap (default 512m)
#   COLLAB_DOMAIN               - OOB collaborator domain (default oob.lab)
#   COLLAB_HTTP_PORT            - OOB HTTP port (default 80)
#   COLLAB_HTTPS_PORT           - OOB HTTPS port (default 443)
#   COLLAB_DNS_PORT             - OOB DNS port (default 53)
#   COLLAB_PUBLIC_URL           - PUBLIC HTTPS base URL for the OOB collaborator
#                                 (e.g. a Tailscale Funnel URL:
#                                 https://<device>.<tailnet>.ts.net). When set,
#                                 collab_generate returns path-based PUBLIC
#                                 callback URLs (<url>/c/<id>/), the token-gated
#                                 /r/<id>?to=<url> 302 redirect endpoint goes
#                                 live, and scan_ssrf blind payloads point at
#                                 the public host. Unset = lab subdomain mode
#                                 (oob.lab; DNS interaction signal only there).
#                                 Funnel walkthrough: `tailscale funnel
#                                 <COLLAB_HTTP_PORT>` (see README OOB section).
#   PLAYWRIGHT_SIDECAR          - launch the scope-enforcing rendered-DOM recon
#                                 sidecar at bootstrap (default off; set 1 to
#                                 enable). Needs `pip install playwright` and
#                                 the Chromium browser installed INTO THE REPO
#                                 at .pw-browsers/ (gitignored) — see README.
#   PLAYWRIGHT_SIDECAR_HOST/PORT - sidecar bind (default 127.0.0.1 / 8484)
#   PLAYWRIGHT_STORAGE_STATE    - path to a Playwright storageState JSON for
#                                 auth'd crawling (env/deploy-time only)
#   R2_BINARY_TARGETS_ROOT      - Radare2 binary drop folder (default binaries/)
#   R2_OUTPUT_CAP               - run_r2 output cap in bytes (default 32768;
#                                 head+tail truncation with omission marker;
#                                 0 disables truncation entirely)
#   R2_TIMEOUT                  - r2 subprocess timeout in seconds (default 120)
#   JADX_*                      - jadx tool caps/tuning (see the jadx block below;
#                                 defaults match the in-code values)
#   WORDLISTS_ROOT              - wordlist tree root (default /usr/share/wordlists)
#   SCRATCH_TTL_HOURS           - scratch entry lifetime, hours (default 24)
#   SCRATCH_MAX_PAYLOAD_MB      - max scratch entry size, MiB (default 256)
#   SCRATCH_MAX_AGENT_MB        - per-agent scratch cap, MiB (default 1024)
#   SCRATCH_SMALL_RESULT_BYTES  - results under this size bypass projection and
#                                 return in full (default 2048)
#   COOKIE_JAR_DB               - universal cookie jar / token vault SQLite file
#                                 (default <workspace>/cookie_jar.db)
#   COOKIE_JAR_TTL_HOURS        - jar entry lifetime, hours (default 72)
#   MEMORY_HALF_LIFE_HOURS      - recency decay half-life for recall_text ranking
#                                 (default 48; after this many hours a memory's
#                                 recency score drops to 0.5)
#   MEMORY_RECENCY_WEIGHT       - blend weight for recency vs similarity in recall
#                                 (default 0.35; 0 = pure similarity, 1 = pure recency)
#   MSFVENOM_BIN                - explicit msfvenom path (else known paths, then PATH)
#   MSFVENOM_DROPBOX            - payload artifact output folder (default dropbox/)
#   MSFVENOM_TIMEOUT            - msfvenom wall-clock cap, seconds (default 300)
#   MSFVENOM_MENU_MAX_ROWS      - rows msfvenom_menu returns before truncation (default 80)
#   SESSION_UPLOAD_MAX_MB       - session_upload source size cap, MiB (default 64)
#   PCAP_DIR                    - pcap capture output folder (default pcaps/;
#                                 gitignored — mirrors the msfvenom dropbox pattern)
#   PCAP_MAX_PACKETS_PER_FILE   - hard cap on packets per pcap file (default 100000;
#                                 prevents unbounded capture sizes from OOM)
#   PCAP_MAX_FILE_MB            - max pcap file size, MiB (default 512; enforced on
#                                 load to avoid blowing up the Brain wire frame)
#   PACKET_CRAFT                - default packet interface shared by the online-facing
#                                 packetcraft tools and masscan (packetcraft in-code
#                                 fallback enp92s0; per-call params override)
# -----------------------------------------------------------------------------
# Dev-checkout driving-LLM knob ONLY (health probe / client reference): the
# deb conffile deliberately does not carry this — the headless build reads
# no chat model. Loopback or LAN, never a cloud LLM API (Legal Addendum).
OLLAMA_BASE_URL=""
MSGRPC_PASSWORD=""
ZAP_API_KEY=""
GATEWAY_API_KEY=""
# GATEWAY_HOST="127.0.0.1"   # gateway bind — loopback default; 0.0.0.0 = deliberate widening (see daharness-safety(7))
EMBED_MODEL=""
# ── Embedding endpoint — provider-agnostic, three shared knobs ──────────────
# One body shape ("model"+"input") POSTs to EMBED_URL; responses in the
# Ollama-native or OpenAI-compatible wire shape both parse. The tool
# registry and memory lanes share these (daharness/embedding.py). Empty
# values = shipped defaults (Ollama native /api/embed, nomic-embed-text).
#   EMBED_URL     - full POST target of the embeddings endpoint
#   EMBED_MODEL   - model id sent in the body (re-index after changing it)
#   EMBED_API_KEY - optional; set => Authorization: Bearer <key>
# Provider recipes:
#   Ollama (native, the shipped default):
#     EMBED_URL="http://localhost:11434/api/embed"
#   OpenAI:
#     EMBED_URL="https://api.openai.com/v1/embeddings"
#     EMBED_MODEL="text-embedding-3-small"
#     EMBED_API_KEY="sk-..."
#   Together / Fireworks / Mistral / Jina (same OpenAI-compat shape):
#     EMBED_URL="https://api.together.xyz/v1/embeddings"
#     EMBED_URL="https://api.mistral.ai/v1/embeddings"  EMBED_MODEL="mistral-embed"
#   LM Studio / vLLM / llama.cpp server on your LAN:
#     EMBED_URL="http://model-box:1234/v1/embeddings"
#     EMBED_URL="http://gpu-box:8000/v1/embeddings"     EMBED_MODEL="bge-m3"
#   Voyage (Bearer key, same body):
#     EMBED_URL="https://api.voyageai.com/v1/embeddings" EMBED_MODEL="voyage-3"
#   Ollama via the OpenAI-compatible lane also works:
#     EMBED_URL="http://localhost:11434/v1/embeddings"
# NOTE egress: the endpoint receives everything you embed — memory contents
# carry finding text (credentials, hosts, report material). Keep it
# loopback/LAN for live engagements; a cloud embeddings provider is a
# third-party data channel (README legal addendum).
EMBED_URL=""
EMBED_API_KEY=""
BRAIN_DISPATCH_TIMEOUT=600
#   BRAIN_READY_TIMEOUT          - bootstrap wait for the Brain socket (default 30)
BRAIN_READY_TIMEOUT=30
SQLMAP_TIMEOUT=1800
# State + dev workspace root (run/, ids.db, scratch.db, scope, engagement,
# cookie_jar, .memory). Tool DISCOVERY ignores it — it follows the code
# checkout (FRAMEWORK_ROOT), so the index finds the shipped tree even when
# state lives elsewhere.
WORKSPACE_ROOT="/path/to/your/workspace/"

# --- Board auth (scope lane: `scope on <handle> --platform P`) -----------------
# HackerOne API, Basic auth (hackerone.com -> Settings -> API Tokens).
#   H1_API_USERNAME / H1_API_TOKEN
#   Without them the H1 tools return an auth_required error; the
#   program_hacktivity feed stays public and works either way.
# Intigriti researcher API (PAT) + your researcher handle:
#   INTIGRITI_USERNAME / INTIGRITI_API_TOKEN
# Bugcrowd endpoints are public API — only the researcher handle:
#   BUGCROWD_USERNAME=            (falls back to H1_API_USERNAME)
# Generic fallback handle for any other platform's username lookup:
#   RESEARCHER_USERNAME=
# On the package, the SYSTEM units (brain / MCP lanes) get tokens from the
# packaged conffile /etc/daharness/daharness.env (the units' EnvironmentFile),
# NOT from this example — see its commented Board auth block. chmod 0600 the
# conffile once tokens are in it.
BUGCROWD_USERNAME=""
RESEARCHER_USERNAME=""
H1_API_USERNAME=""
H1_API_TOKEN=""
INTIGRITI_USERNAME=""
INTIGRITI_API_TOKEN=""
# --- optional, uncomment to override in-code defaults -------------------------
# ZAP_HOST="127.0.0.1"
# ZAP_PORT="8090"
# ZAP_XMX="512m"
# ZAP_PROXY_BIND="0.0.0.0"
# --- Burp Suite MCP Server BApp (opt-in, not launched by bootstrap) ---------
# Set BURP_MCP=1 to enable the launch-time healthcheck.  The operator must
# run Burp Suite with the 'MCP Server' BApp installed and enabled (MCP tab).
# Unlike ZAP/MSF, Burp is a GUI app we do NOT launch — this only configures
# where the BApp's SSE endpoint is.  Approval dialogs in the BApp must be
# disabled or targets pre-approved in its config (no in-harness lane can
# see Swing popups).  No active scan via MCP (use ZAP); Collaborator/Scanner
# tools are Pro-only (use the framework's own collaborator instead).
# BURP_MCP="1"
# BURP_MCP_HOST="127.0.0.1"
# BURP_MCP_PORT="9876"
# BURP_MCP_SSE_PATH="/"
# BURP_MCP_CONNECT_TIMEOUT="10"
# BURP_MCP_READ_TIMEOUT="300"
# BURP_MCP_CALL_TIMEOUT="60"
# MCP_ENDPOINT="http://127.0.0.1:55553"
# MSF_RPC_PORT="55553"
# ROUTER_MAX_DISTANCE="1.1"
# CHROMA_HOST="localhost"
# CHROMA_PORT="9000"
# BRAIN_SCAN_DIRS="auxiliaries,listeners,payloads"
# COLLAB_DOMAIN="oob.lab"
# COLLAB_HTTP_PORT="80"
# COLLAB_HTTPS_PORT="443"
# COLLAB_DNS_PORT="53"
# COLLAB_PUBLIC_URL=""         # e.g. "https://mybox.mytailnet.ts.net"
# --- playwright rendered-DOM recon sidecar (opt-in) --------------------------
# Set to 1 to launch the headless-Chromium scope-enforcing recon sidecar at
# bootstrap. Requires the browser installed INTO THE REPO (gitignored) so the
# path is workspace-relative and root can find it:
#   PLAYWRIGHT_BROWSERS_PATH="$WORKSPACE_ROOT/.pw-browsers" \
#     python -m playwright install chromium
# The sidecar auto-resolves .pw-browsers/ from WORKSPACE_ROOT, so you usually
# do NOT need to set PLAYWRIGHT_BROWSERS_PATH yourself at launch time.
# PLAYWRIGHT_SIDECAR="1"
# PLAYWRIGHT_SIDECAR_HOST="127.0.0.1"
# PLAYWRIGHT_SIDECAR_PORT="8484"
# PLAYWRIGHT_STORAGE_STATE=""   # path to a storageState JSON for auth'd crawling
# R2_BINARY_TARGETS_ROOT="binaries/"
# --- jadx APK-analysis tool caps (all optional; uncomment to override) -------
# Workspaces live under <JADX_APK_TARGETS_ROOT>/decompiled/; grep/tree page
# through big decompiled trees, so these caps are per-call raiseable too
# (grep: max_matches/max_files, tree: limit — env sets the DEFAULTS+CEILINGS).
# JADX_APK_TARGETS_ROOT="apk/"   # apk drop folder (targets auto-resolve by name)
# JADX_BIN=""                    # explicit jadx binary path (else PATH lookup)
# JADX_OUTPUT_CAP="204800"       # max bytes returned per read/decompile (200 KiB)
# JADX_TIMEOUT="900"             # jadx subprocess wall-clock cap, seconds
# JADX_GREP_MAX_MATCHES="200"    # default matches per grep page
# JADX_GREP_MATCHES_CEILING="2000"  # hard ceiling on caller-raised max_matches
# JADX_GREP_MAX_FILES="4000"     # default file-scan cap per grep
# JADX_GREP_FILES_CEILING="50000"  # hard ceiling on caller-raised max_files
# JADX_TREE_LIST_CAP="500"       # default page size for the tree listing
# WORDLISTS_ROOT="/usr/share/wordlists"
# PCAP_DIR=""                  # blank = <repo>/pcaps/ (gitignored)
# PCAP_MAX_PACKETS_PER_FILE="100000"
# PCAP_MAX_FILE_MB="512"
# PACKET_CRAFT="enp92s0"
# SCRATCH_TTL_HOURS="24"
# SCRATCH_MAX_PAYLOAD_MB="256"
# SCRATCH_MAX_AGENT_MB="1024"
# SCRATCH_SMALL_RESULT_BYTES="2048"
# MEMORY_HALF_LIFE_HOURS="48"
# MEMORY_RECENCY_WEIGHT="0.35"
# --- large mode caps (default result projection for every lane) --------------
# `large` is the default result_mode for REST, MCP, and OWUI.
# It passes results under the byte cap through unchanged (zero behavior
# change for normal results) and field-truncates + stores-in-scratch when
# a single response would blow up context. `full` is gone — aliased to
# `large` (it was an unbounded passthrough that could 6x a cloud model's
# context). `digest` is the compact one-liner mode; `page` is list paging.
# LARGE_MODE_BYTE_CAP="16384"    # total serialized bytes before capping (16 KiB)
# LARGE_FIELD_CHAR_CAP="4096"    # per-string-field truncation when capped
# COOKIE_JAR_DB=""               # blank = <workspace>/cookie_jar.db
# COOKIE_JAR_TTL_HOURS="72"
# --- msfvenom payload generation + multipart upload lane ----------------------
# MSFVENOM_BIN=""               # explicit path; else known paths, then PATH
# MSFVENOM_DROPBOX=""           # blank = <repo>/dropbox/ (gitignored)
# MSFVENOM_TIMEOUT="300"        # seconds; encoder+iteration runs can be slow
# MSFVENOM_MENU_MAX_ROWS="80"
# SESSION_UPLOAD_MAX_MB="64"    # per-call source cap for session_upload
# TOOL_BUDGET_PER_TURN="10"      # per-turn tool-call cap per agent (0 = off)
# TOOL_BUDGET_IDLE_RESET_MIN="5" # rolling reset when no turn_key is passed
# TOOL_BUDGET_TERMINAL_ALLOWLIST="utils.memory_tools.,utils.findings."
# POST_EXECUTION_LOGS="failures"
# --- IPython editor escape hatches (tool_repl ipython command) ---------------
# IPYTHON_EDITOR="nvim"          # editor for F2 / Ctrl+X Ctrl+E / %edit
#                                # (save+quit pipes the cell back to IPython)
# IPYTHON_NVIM_ESCAPE="1"        # F3 launches full nvim in workspace root
#                                # (:qa returns to IPython, state intact)
# -----------------------------------------------------------------------------
# End of example

# --- web-session shape (evasion/webshape.py) ---
# SESSION_UA=          # fixed UA override; 'legacy' = old framework marker
# SESSION_HOST_FLOOR=  # per-host min seconds between requests (e.g. 1.5); off if unset
# SESSION_IMPERSONATION=auto
#                      # auto|off — TLS/header impersonation for the web session lane
#                      # (default auto): the sticky per-host identity resolves the
#                      # curl-impersonate template whose TLS stack + header set/order
#                      # match the UA claim. 'off' = plain python-requests client —
#                      # same UA, generic TLS story; the envelope's fingerprint
#                      # reports degraded. Needs curl_cffi (pip install -e ".[web]");
#                      # without it, auto degrades
#
# --- responder analog (listeners/responder_analog.py) ---
# RESPONDER_JOB_TIMEOUT_H=12  # wall-clock cap per responder job (hours);
#                             # 'responders_stop' is the normal way down
# SHAPING_LAB_MODE="1"        # lab gate for deceptive wire traffic — required by
#                             # the responder's LLMNR/NBT-NS poisoning AND by
#                             # shaping.py's decoy/fragment presets

# --- engagement cobweb (utils/engagement.py + utils/journal.py, 2026-10-19) ---
# One slug ties journal + evidence rows across every lane; purging an
# engagement is one transaction under the operator role only. Postgres is an
# OPTIONAL lane: absent DB -> journal/evidence degrade to the sqlite mirror,
# nothing breaks. Install: pip install -e ".[db]" (psycopg).
HARNESS_DB_LANE=           # repl_lane|gateway_lane|brain_lane — per-process
# auth identity; journal rows attribute the lane
# from it (default repl_lane)
# HARNESS_DB_HOST=127.0.0.1  # lane endpoint; the deb's daharness-pg init
#                             # ALSO mirrors it into the cluster bind — 0.0.0.0
#                             # = listen '*' + lane pg_hba block, container
#                             # lanes reach the host at the gateway 172.28.0.1
HARNESS_DB_PORT=5432
HARNESS_DB_NAME=harness
HARNESS_DB_PASSWORD_REPL=      # per-lane creds — defaults match
HARNESS_DB_PASSWORD_GATEWAY=   # packaging/postgres/init/001_roles.sh
HARNESS_DB_PASSWORD_BRAIN=
HARNESS_DB_PASSWORD_OPERATOR=  # operator-only: engagement close+purge
EVIDENCE_CRED_TTL_HOURS=24     # credential material floor (residency decision:
# TTL bounds secrets, never mid-engage scrubbing)
EVIDENCE_OPEN_TTL_HOURS=168    # non-cred, non-scope open items (scope questions
# never expire — safety-adjacent state)
