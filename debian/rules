#!/usr/bin/make -f

# replkit joins the copy: tool_repl.py (daharness-repl + the kernel unit)
# imports it top-level — omitted from the first cut, so the deb's REPL died
# instantly with "No module named replkit" (observed on VM 2026-10-20).
TREE_DIRS := daharness utils auxiliaries payloads listeners evasion replkit tests

%:
	dh $@

# frameit.so is the Brain's C gate (unguarded module-level CDLL): sources
# ship in git, the artifact is gitignored — the deb builds it right here.
override_dh_auto_build:
	gcc -shared -o listeners/plugins/frameit.so -fPIC listeners/plugins/frameit.c

# No override_dh_auto_test: the vendor-arming test that ran here was
# deleted with chromadb (tests/test_vendor_arming.py is gone). The deb's
# own test suite runs via `daharness-repl selftest` (the operator macro),
# not at build time — the build lane may be network-isolated.

override_dh_auto_install:
	mkdir -p debian/daharness/usr/share/daharness
	# No vendored wheels: chromadb was removed (replaced by a local
	# SQLite + numpy vector store — no server process, no network
	# dependency at build time). pytest is no longer vendored either —
	# it rides the apt lane (python3-pytest in Build-Depends) or the
	# operator's own pip install for the selftest macro. This removes
	# the last pip-install in the build, making the deb buildable on a
	# network-isolated host.
	for d in $(TREE_DIRS); do \
	  cp -a $$d debian/daharness/usr/share/daharness/; \
	done
	cp -a -- *.py debian/daharness/usr/share/daharness/
	# dacustoms scaffold (operator-authored tools template): ships under
	# packaging/dacustoms/ so the operator copies it to ~/.dacustoms on
	# first use. Not a state-root lane — lives in $HOME, not /var/lib.
	mkdir -p debian/daharness/usr/share/daharness/packaging/dacustoms
	cp -a packaging/dacustoms/* debian/daharness/usr/share/daharness/packaging/dacustoms/
	# Bytecode the ENTIRE staging tree, not just vendor/ (purge-residue fix,
	# 2026-10-20 VM round-trip: runtime imports wrote untracked __pycache__
	# into the root-owned tree, so dpkg purge left every module dir behind
	# with "directory not empty so not removed" — 98 .pyc survived as
	# residue alongside a stray ids.db). Tracked .pyc keep the ~3-6x repeat
	# import speedup the vendor-only compile gave daemon boots, and dpkg
	# now removes them with the package. Runs AFTER the tree copy so .pyc
	# source-mtime headers match the staged .py files (dpkg preserves
	# mtimes end-to-end — no import-time rewrite, no residue regeneration).
	python3 -m compileall -q -f debian/daharness/usr/share/daharness
	install -D -m 0644 .env.example debian/daharness/usr/share/daharness/.env.example 2>/dev/null || true
	# pytest rootdir config: testpaths=["tests"] keeps ANY pytest spawn in
	# the tree off the vendored closure's own test files (they break
	# collection — observed live on the deb 2026-10-20).
	install -m 0644 pyproject.toml debian/daharness/usr/share/daharness/pyproject.toml
	# profile conffile: /etc/daharness/daharness.env (system profile knobs)
	install -D -m 0644 packaging/etc/daharness.env debian/daharness/etc/daharness/daharness.env
	# operator-shell plumbing: login shells source /etc/profile.d (the units'
	# EnvironmentFile never reaches a human shell), so the system-profile
	# roots resolve without code archaeology. Wrappers source it too for
	# non-login invocations (ssh host cmd, CI).
	install -D -m 0644 packaging/profile/daharness.sh debian/daharness/etc/profile.d/daharness.sh
	# scope manifest template: the scope/<platform>_<handle>.json naming and
	# layout are code knowledge — postinst seeds this into the state root so
	# an operator can arm a temp local-lab scope off rip (edit, then
	# `python tool_repl.py scope on local-lab --platform lab`).
	install -D -m 0644 packaging/examples/scope/lab_local-lab.json \
		debian/daharness/usr/share/daharness/examples/scope/lab_local-lab.json
	# entrypoint wrappers (systemd ExecStart targets)
	install -D -m 0755 packaging/bin/daharness debian/daharness/usr/bin/daharness
	install -D -m 0755 packaging/bin/daharness-kernel debian/daharness/usr/bin/daharness-kernel
	install -D -m 0755 packaging/bin/daharness-repl debian/daharness/usr/bin/daharness-repl
	# optional engagement-Postgres lane (daharness-pg(1)) + its init bundle:
	# installed but inert until `sudo apt install postgresql` + `daharness-pg init`.
	install -D -m 0755 packaging/bin/daharness-pg debian/daharness/usr/bin/daharness-pg
	# operator re-index pass: fresh deb ships an EMPTY registry;
	# nothing fills it for you (daemon boot never indexes — deliberate).
	install -D -m 0755 packaging/bin/daharness-index debian/daharness/usr/bin/daharness-index
	# python/c -> python/rust upgrade lane (daharness-rust(1)): the three
	# crate sources ship above; building them is the user's opt-in
	# network step — one command instead of paste-bombs. Installed and
	# inert until run, like daharness-pg.
	install -D -m 0755 packaging/bin/daharness-rust debian/daharness/usr/bin/daharness-rust
	# The IDE-facing stub lane ships with the wrapper that routes to it
	# (daharness-index --stubs); the rest of scripts/ stays dev/container
	# tooling, not package payload.
	install -D -m 0644 scripts/gen_repl_stubs.py \
	  debian/daharness/usr/share/daharness/scripts/gen_repl_stubs.py
	# The stub lane forks pyright's typeshed builtins.pyi (a stubPath-
	# resolved builtins.pyi REPLACES the engine's — completeness is
	# load-bearing). Bundle an engine copy so a clean deb operator
	# (no ~/.vscode-server, no wheel pyright) can still generate.
	install -D -m 0644 scripts/pyright_typeshed_builtins.pyi \
	  debian/daharness/usr/share/daharness/scripts/pyright_typeshed_builtins.pyi
	install -d -m 0755 debian/daharness/usr/share/daharness/postgres/init
	install -m 0644 packaging/postgres/init/001_roles.sh \
		packaging/postgres/init/002_schemas.sql \
		packaging/postgres/init/003_functions.sql \
		packaging/postgres/init/004_operator_registry_acl.sql \
		debian/daharness/usr/share/daharness/postgres/init/
	# daharness-pg.1 is picked up by the packaging/man/*.1 glob in
	# debian/daharness.manpages
	# post-install import-floor audit (runbook step 4): the deb carries its
	# own floor driver; packaging/ is not an ALLOWED_TOOL_ROOT so the Brain
	# never mints it as a tool.
	mkdir -p debian/daharness/usr/share/daharness/packaging
	install -m 0644 packaging/l2_import_floor.py \
	  debian/daharness/usr/share/daharness/packaging/l2_import_floor.py
	# system units: dh_installsystemd sees these in the staging tree and
	# hooks postinst enable (not started: --no-start, operator starts them
	# per runbook step 7); kernel unit is the background tool_repl host,
	# enabled-not-started same posture.
	install -D -m 0644 packaging/systemd/daharness.service \
	  debian/daharness/lib/systemd/system/daharness.service
	install -D -m 0644 packaging/systemd/daharness-kernel.service \
	  debian/daharness/lib/systemd/system/daharness-kernel.service
	# Auto-enable lane: Kali's 99-default.preset vetoes every *.service in
	# the first-install `systemctl preset` pass; preset rules are first-match
	# by ascending filename, so this file slots between Kali's 95-kali
	# whitelist and the 99-default catch-all and re-enables ours (ledger
	# mechanics: KALI PRESET POLICY).
	install -D -m 0644 packaging/systemd/98-daharness.preset \
	  debian/daharness/usr/lib/systemd/system-preset/98-daharness.preset
	# Rust lane sources (three crates under rust/: scratch, pcap, brain).
	# Shipped as SOURCE — the deb build stays python+C only (no cargo
	# Build-Depends: the build lane is network-isolated and these crates
	# pull the crates.io tree). The scratch/pcap crates are library ports of
	# the python stores (same schema/WAL semantics); the brain crate is the
	# WIP rust sidecar — its worker lane (brain/worker.py + the root
	# tool_exec.py module, already staged) imports the real registry. Build
	# output and crate-internal state never stage (target/, run/).
	install -d -m 0755 debian/daharness/usr/share/daharness/rust
	for d in scratch pcap brain; do \
	  cp -a rust/$$d debian/daharness/usr/share/daharness/rust/; \
	  rm -rf debian/daharness/usr/share/daharness/rust/$$d/target \
	         debian/daharness/usr/share/daharness/rust/$$d/run; \
	done
	# Prune at ALL depths, then delete any socket file: a stale staged
	# tree from an earlier rules variant once nested a whole copy here
	# (rust/rust/brain/run/brain-worker.sock), and dh_dwz -a aborts the
	# whole build on a staged UNIX socket it cannot open (2026-10-30).
	# The deb tree must ever only carry rust source text.
	find debian/daharness/usr/share/daharness/rust -type d \
	  \( -name target -o -name run \) -prune -exec rm -rf {} +
	find debian/daharness/usr/share/daharness/rust -type s -delete
	# init.d fallback scripts (systemd-less hosts: NetHunter chroot, WSL1).
	# Shipped under packaging/initd/ so postinst copies them to /etc/init.d/
	# ONLY when systemd is absent — the systemd lane never touches them.
	# Same /usr/bin/daharness + /usr/bin/daharness-kernel entry points the
	# units hit, so daemon behavior is identical across supervisors.
	install -d -m 0755 debian/daharness/usr/share/daharness/packaging/initd
	install -m 0755 packaging/initd/daharness \
	  packaging/initd/daharness-kernel \
	  debian/daharness/usr/share/daharness/packaging/initd/
	# user-profile units ship as documented examples (system units are the
	# enabled ones via dh_installsystemd); verified on the VM smoke
	mkdir -p debian/daharness/usr/share/doc/daharness/systemd-user
	install -m 0644 packaging/systemd/user/*.service \
	  debian/daharness/usr/share/doc/daharness/systemd-user/

override_dh_installsystemd:
	dh_installsystemd --no-start