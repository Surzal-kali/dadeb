#!/bin/sh
set -e

# Purge-residue lane (2026-10-20 VM round-trip census). dpkg removes exactly
# the files recorded in its manifest + the conffiles; anything the postinst
# minted or any runtime lane wrote is invisible to it — that residue is what
# this script handles on `purge`. Deliberately inert on plain `remove`
# (dpkg keeps conffiles there by design, so remove stays conservative).

if [ "$1" = "purge" ]; then
    # 1. Package tree leftovers. postrm runs AFTER dpkg removed every tracked
    #    file, so /usr/share/daharness holds only untracked residue here:
    #    runtime __pycache__ (legacy installs predate the build-time
    #    compileall) and state files a pre-fallback lane wrote into the
    #    read-only tree (ids.db, observed live 2026-10-20). dpkg's own
    #    warnings ("directory not empty so not removed") are what this
    #    finishes off.
    rm -rf /usr/share/daharness 2>/dev/null || true

    # 2. The daharness-pg credential file. NOT operator work product —
    #    `daharness-pg init` re-mints it losslessly (init re-runs the bundle
    #    and ALTERs the lane roles when pg.env is absent), so keeping a
    #    PASSWORD-bearing file on purge buys nothing and ships a half-state:
    #    /etc/daharness/daharness.env (the conffile, also carrying a
    #    generated key) is already gone here. The CLUSTER it points at is a
    #    different matter — engagement journal data — so the cluster itself
    #    stays (pointed at below, daharness-pg(1) PURGE section); dropping
    #    it via the ledger's pg_dropcluster line is enough — no file pair
    #    to worry about, the next `daharness-pg init` re-mints pg.env.
    if [ -f /etc/daharness/pg.env ]; then
        rm -f /etc/daharness/pg.env
        echo "daharness: removed /etc/daharness/pg.env (daharness-pg init re-mints it)"
    fi
    # Best-effort: drop the empty /etc/daharness dir after conffile + pg.env
    # removal too (a state-hostile tree the next install re-creates).
    rmdir /etc/daharness 2>/dev/null || true

    # 3. Stray units from PAST iterations (pre-deb dev checkout installs:
    #    `sudo cp scripts/daharness.service /etc/systemd/system/` was the
    #    old README's install step). dpkg never tracked them and they
    #    shadow the packaged system profile: after a purge their ExecStart
    #    points at a removed/venv path — a zombie that revives on every
    #    `systemctl daemon-reload`. Same class as the broken per-user
    #    kernelspec. Only touched when they reference a dev checkout (the
    #    deb's real units live in /lib/systemd/system and are
    #    dpkg-tracked — they are gone by postrm time and never match the
    #    grep, so a same-name foreign unit an operator wrote is safe unless
    #    it carries a checkout ExecStart).
    for _UNIT in daharness.service daharness-kernel.service; do
        _F="/etc/systemd/system/$_UNIT"
        if [ -f "$_F" ] && grep -q "ExecStart=.*github/.*/bootstrap.py\|ExecStart=.*github/.*/tool_repl.py\|WorkingDirectory=.*github/" "$_F" 2>/dev/null; then
            systemctl stop "$_UNIT" 2>/dev/null || true
            systemctl disable "$_UNIT" 2>/dev/null || true
            rm -f "$_F"
            echo "daharness: removed stray pre-package unit $_F (dev-checkout ExecStart)"
        fi
    done
    unset _UNIT _F
    # Wants symlinks those stray units pulled in via `systemctl enable`.
    find /etc/systemd/system -type l -lname "/etc/systemd/system/daharness*" -delete 2>/dev/null || true

    # 4. The dedicated system identity postinst minted (adduser --system).
    #    Revoked only if the account still looks exactly like ours — a system
    #    uid, our nologin shell, our home — so a homonymous user an operator
    #    made independently is never touched. NOT deleting /var/lib/daharness
    #    (the home / StateDirectory): operator work product — see the pointer
    #    block below + daharness-safety(7).
    _PW=$(getent passwd daharness 2>/dev/null || true)
    if [ -n "$_PW" ] && command -v deluser >/dev/null 2>&1; then
        _HOME=$(echo "$_PW" | cut -d: -f6)
        _SHELL=$(echo "$_PW" | cut -d: -f7)
        if [ "$_HOME" = /var/lib/daharness ] && [ "$_SHELL" = /usr/sbin/nologin ]; then
            deluser --system daharness 2>/dev/null || true
        fi
    fi
    # Group follows only when empty (postinst granted sudo members to it —
    # with members left, delgroup refuses and the grant survives for reuse).
    if getent group daharness >/dev/null 2>&1 && command -v delgroup >/dev/null 2>&1; then
        if ! delgroup --only-if-empty daharness 2>/dev/null; then
            echo "daharness: group kept — non-system members remain (sudo users re-granted on reinstall)"
        fi
    fi
    unset _PW _HOME _SHELL
    echo "daharness: removed system uid while KEEPING /var/lib/daharness — files" \
         "under the state root now carry a ghost uid; the next install's" \
         "postinst re-chowns the tree to the re-minted identity (state is" \
         "kept, not lost)."

    # 5. What survives ON PURPOSE (operator decisions). A maintainer script
    #    never scrubs user homes or silently deletes engagement work
    #    product; it points at the knobs instead.
    echo "daharness: purge kept intentional operator state (daharness-safety(7), purge section):"
    echo "  /var/lib/daharness/       findings/engagement/scratch state - rm -rf if you want it gone"
    echo "  postgres cluster 18/daharness (pg_lsclusters; engagement journal) -" \
         "sudo pg_dropcluster --stop 18 daharness to discard"
    echo "  ~/.local/share/jupyter/kernels/daharness  per-user kernelspec - rm -rf if you want it gone"
    echo "  ~/.local/share/framework-stubs/           per-user IDE stubs   - rm -rf if you want it gone"
fi

#DEBHELPER#