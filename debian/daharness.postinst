#!/bin/sh
set -e

# Dedicated system identity (ledger decision: profiles, UMask 0007 group
# sharing). StateDirectory= in the unit owns /var/lib/daharness at start.
if ! getent passwd daharness >/dev/null; then
    adduser --system --group --home /var/lib/daharness \
        --shell /usr/sbin/nologin daharness
fi

# Shared-state PERMISSIONS: a group-membership grant alone does not make
# the state shareable — adduser's own SYS_DIR_MODE (0755) ships the root
# without group write, and without setgid (2770) every file an operator's
# shell creates lands operator-owner:operator-group (kali:kali), invisible
# to the service lanes. Shaping happens HERE (also on upgrades, for legacy
# trees) and in the units' StateDirectoryMode=2770 (re-asserted on every
# start; a plain 0750 there would strip the setgid). Dirs under a setgid
# root inherit the bit, so the tree stays group-shared as both lanes
# create things — proven live (setgid dir gid inheritance, 2026-10-20).
STATE_ROOT=/var/lib/daharness
if [ -d "$STATE_ROOT" ]; then
    if [ "$(stat -c %U "$STATE_ROOT" 2>/dev/null)" != "daharness" ]; then
        chown -R daharness:daharness "$STATE_ROOT"
        echo "daharness: reconciled $STATE_ROOT ownership to daharness:daharness (legacy tree)"
    fi
else
    mkdir -p "$STATE_ROOT"
    chown daharness:daharness "$STATE_ROOT"
    echo "daharness: created $STATE_ROOT (first install — scope seeding below now applies)"
fi
chown daharness:daharness "$STATE_ROOT"
chmod 2770 "$STATE_ROOT"


# Ghost-uid reconcile (2026-10-21 VM round-trip): dpkg purge keeps
# /var/lib/daharness (operator work product), but dpkg ALSO deletes the
# system user — so a reinstall mints a NEW uid under the SAME state root.
# The tree's deep dirs (.cache/, .config/, ids.db, ...) keep the
# OLD uid, which now maps to nothing. systemd's StateDirectory= only
# re-asserts the TOP dir (daharness:daharness 2770) on every start, so the
# wrong-owner subtree survives untouched: observed live — sqlite opened its
# persisted sqlite under ghost-uid ownership and panicked with "attempt to
# write a readonly database" 31s after every spawn (pyo3 PanicException),
# waited its full budget on the corpse, and the gateway
# then died on the ToolRegistry handshake. find-chown the whole tree: a
# reinstall is exactly the moment ghost uids exist; chowning operator
# files back to the (re-minted) daharness identity is the healing the
# kept-state doctrine requires. Best effort — never fail the install.
find "$STATE_ROOT" -xdev \( ! -user daharness -o ! -group daharness \) \
    -exec chown daharness:daharness {} + 2>/dev/null || true

# Analysis drop lanes (r2 binaries/ + jadx apk/ with its decompiled/ workspaces):
# operator content, so they live in the STATE root alongside scope/ — not the
# read-only package tree the tools resolve their old code-root defaults from.
# The tool modules resolve them via WORKSPACE_ROOT; mkdir-if-missing so
# upgrades repair legacy trees too. 2770 setgid keeps the service lane and
# group-member operators co-writing (same shape the scope/ seeding uses).
for _LANE in binaries apk; do
    if [ ! -d "$STATE_ROOT/$_LANE" ]; then
        install -d -m 2770 "$STATE_ROOT/$_LANE" 2>/dev/null || true
    fi
    chown daharness:daharness "$STATE_ROOT/$_LANE" 2>/dev/null || true
    chmod 2770 "$STATE_ROOT/$_LANE" 2>/dev/null || true
    echo "daharness: drop lane ready at $STATE_ROOT/$_LANE (binaries/APK analysis targets go there)"
done
unset _LANE

# dacustoms: operator-authored tools (out-of-tree, update-safe).
# The deb pins DACUSTOMS_DIR=/var/lib/daharness/dacustoms in daharness.env
# so the service-user Brain and the operator shell resolve the same path.
# Create the dir here (state root is provisioned above, group-writable 2770)
# and seed the package __init__.py so the meta-path finder resolves on
# first boot. The operator drops .py files in directly — no per-user setup.
if [ -d /var/lib/daharness ]; then
    _DC=/var/lib/daharness/dacustoms
    mkdir -p "$_DC"
    # Seed __init__.py only if absent — never clobber an operator's edits.
    if [ ! -f "$_DC/__init__.py" ]; then
        cp /usr/share/daharness/packaging/dacustoms/__init__.py "$_DC/__init__.py" 2>/dev/null || true
    fi
    chown -R daharness:daharness "$_DC" 2>/dev/null || true
    chmod 2770 "$_DC" 2>/dev/null || true
    unset _DC
fi
echo "daharness: dacustoms lane ready — drop .py tools in /var/lib/daharness/dacustoms/"
echo "daharness:   out-of-tree operator macros (DACUSTOMS_DIR, group-readable, update-safe)"
echo "daharness:   example tools at /usr/share/daharness/packaging/dacustoms/"
echo "daharness:   verify with: daharness doctor customs"

# Legacy-tree file MODES: UMask=0007 in the units only shapes files created
# from that unit onward; a state file an older run made under a tighter
# umask (live 2026-10-20: ids.db 0640; live 2026-10-24 on WSL:
# tool_registry.db 644 after a wsl --update — the index wrapper ran under
# the WSL default umask 022 and SQLite's WAL sidecars inherited it) stays
# group-read-only — the operator's SQLite write then dies with "attempt to
# write a readonly database" even on a 2770 root (SQLite needs the main
# file group-writable for its -wal/-shm dance, and the sidecars too).
# Reconcile just the top-level state files to the shape the umask now
# produces. The maxdepth=1 sweep catches the main DB files; the -wal/-shm
# sidecars may not exist yet at postinst time (created on first DB open),
# but if they do they're caught here too (they are top-level files).
# Best effort: 2>/dev/null || true — a genuinely unsharable oddity must
# not fail the install.
find "$STATE_ROOT" -maxdepth 1 -type f ! -perm -g+w \
    -exec chmod g+rw {} + 2>/dev/null || true

# Explicit SQLite sidecar reconcile: even after the generic find above, a
# -wal or -shm sidecar created mid-session (after the postinst's find ran
# on a previous upgrade) can land 644 under a 022-umask process. The
# VectorStore.__init__ now self-heals at open time, but this sweep is the
# offline backstop for an upgrade that restarts the service before any
# index/gateway open touches the DB — so the first WAL write doesn't die.
# Pattern: any *.db, *.db-wal, *.db-shm, *.db-journal in the state root.
for _dbpat in "$STATE_ROOT"/*.db "$STATE_ROOT"/*.db-wal "$STATE_ROOT"/*.db-shm \
              "$STATE_ROOT"/*.db-journal; do
    [ -f "$_dbpat" ] 2>/dev/null || continue
    chmod g+rw "$_dbpat" 2>/dev/null || true
done
unset _dbpat

# Shared-state access provisioning: the state root and brain socket are
# group-shared by design (UMask 0007, RuntimeDirectoryMode=0770), but the
# group has no members unless the operator opts in — a fresh install where
# the operator's own account cannot see the shared state is expected, not
# healed silently. Following the Docker pattern: we create the group and
# tell the operator exactly what to do, but we do NOT auto-enroll anyone.
# Granting group membership silently broadens who can read engagement
# material (credentials, findings) from the state root — a privacy
# decision the operator should make explicitly, not one the package
# should make for them.
if getent group daharness >/dev/null; then
    _ALREADY=$(getent group daharness | cut -d: -f4)
    if [ -z "$_ALREADY" ]; then
        echo "daharness: the 'daharness' group exists but has no members."
        echo "  Add yourself to see the shared state root + brain socket:"
        echo "    sudo usermod -aG daharness \$USER"
        echo "  Then re-login or run: newgrp daharness"
    fi
    unset _ALREADY
fi

# Scope-manifest provisioning: a temp local-lab scope should be editable-off-
# rip, not reconstructed from code knowledge. Seed the lab template into the
# state root's scope/ dir (daharness-owned 2770 setgid so the service lane
# and group-member operators share it; setgid re-groups files created by
# whichever lane writes first). Strictly guarded: an existing
# manifest — operator-customized or re-run — is never stomped.
_TEMPLATE=/usr/share/daharness/examples/scope/lab_local-lab.json
if [ -r "$_TEMPLATE" ]; then
    if mkdir -p /var/lib/daharness/scope; then
        chown daharness:daharness /var/lib/daharness/scope
        # Setgid (2770): operator-authored manifests inherit the daharness
        # group, so the service lane can read them (a 0770 without the bit
        # would strand kali:kali files again).
        chmod 2770 /var/lib/daharness/scope
        if [ ! -e /var/lib/daharness/scope/lab_local-lab.json ]; then
            if install -m 0660 -o daharness -g daharness \
                "$_TEMPLATE" /var/lib/daharness/scope/lab_local-lab.json; then
                echo "daharness: seeded lab scope template at /var/lib/daharness/scope/lab_local-lab.json"
                echo "  edit the subnet/ROE, then arm: python tool_repl.py scope on local-lab --platform lab"
            fi
        fi
    fi
fi
unset _TEMPLATE

# Gateway API key: generate once when the conffile placeholder is still
# empty, so a stock deb never boots an unauthenticated gateway. The
# in-place conffile edit triggers the upgrade prompt ("keep current" — the
# default — preserves the live key); clearing the line + a re-configure
# regenerates it.
if [ -r /etc/daharness/daharness.env ] && \
   grep -q '^GATEWAY_API_KEY=""$' /etc/daharness/daharness.env; then
    if command -v openssl >/dev/null 2>&1; then
        KEY=$(openssl rand -hex 32)
    else
        KEY=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
    fi
    if [ -n "$KEY" ]; then
        sed -i "s|^GATEWAY_API_KEY=.*$|GATEWAY_API_KEY=\"$KEY\"|" /etc/daharness/daharness.env
        echo "daharness: generated GATEWAY_API_KEY into /etc/daharness/daharness.env"
    fi
fi

# ChromaDB retirement (2026-10-23): chromadb was removed entirely — the
# tool registry is now backed by a local SQLite + numpy vector store (no
# server process). Upgrades from earlier packages may still have a
# daharness-chroma.service unit (standalone or merged sidecar): stop +
# disable it here so the orphan doesn't keep :9000 or respawn a binary
# this package no longer ships.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl stop daharness-chroma.service 2>/dev/null || true
    systemctl disable daharness-chroma.service 2>/dev/null || true
    if systemctl is-active daharness-chroma.service >/dev/null 2>&1 || \
       systemctl list-unit-files daharness-chroma.service 2>/dev/null | grep -q daharness-chroma; then
        echo "daharness: retired daharness-chroma.service (chromadb removed — SQLite vector store)"
    fi
fi

# Runtime units must be RE-READ by the running systemd before the next
# (re)start: every service start re-asserts RuntimeDirectoryMode /
# StateDirectoryMode, and a stale systemd unit cache re-applies the OLD
# shapes over whatever this postinst just laid down (observed live
# 2026-10-20: the upgrade wrote StateDirectoryMode=2770 to disk while the
# running cache still held 0750, so the next daemon start reset the root
# to 0750 — every on-disk permission patch looked "not landed" at boot
# time). dh_installsystemd normally triggers the reload; this is the
# belt-and-braces last word so a unit-file change can never be stomped by
# a restart that never saw it.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
fi

# ────────────────────────────────────────────────────────────────────── #
# init.d fallback (systemd-less hosts: NetHunter chroot, WSL1, etc.)
# ────────────────────────────────────────────────────────────────────── #
# Every systemd touch above is guarded — on a systemd-less box none of it
# fires and the units dh_installsystemd installed are inert (no PID 1 to
# read them). The Kali NetHunter app's Kali Services tab drives
# /etc/init.d/, and any systemd-less box needs the same services. So when
# systemd is absent we provision init.d scripts instead: copy the shipped
# scripts into /etc/init.d/, chmod +x, and register them with update-rc.d.
# The scripts launch the SAME /usr/bin/daharness + /usr/bin/daharness-kernel
# entry points the systemd units hit, so daemon behavior is identical
# regardless of supervisor. /run/daharness (the brain.sock home) is mkdir'd
# by the init.d scripts themselves — no RuntimeDirectory on this lane.
if ! ([ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1); then
    _SRC=/usr/share/daharness/packaging/initd
    if [ -d "$_SRC" ]; then
        for _SVC in daharness daharness-kernel; do
            if [ -f "$_SRC/$_SVC" ]; then
                install -D -m 0755 "$_SRC/$_SVC" "/etc/init.d/$_SVC"
                # update-rc.d registers the LSB runlevel symlinks; if it's
                # absent (a truly bare box), the scripts are still usable
                # via direct invocation (/etc/init.d/daharness start).
                if command -v update-rc.d >/dev/null 2>&1; then
                    update-rc.d "$_SVC" defaults 2>/dev/null || true
                fi
                echo "daharness: provisioned init.d script for $_SVC (systemd-less lane)"
            fi
        done
        unset _SVC
        # Ensure /run/daharness exists now too (the scripts mkdir it at
        # start, but a pre-flight mkdir lets an operator's `daharness-repl`
        # reach the socket before the daemon is started manually).
        mkdir -p /run/daharness 2>/dev/null || true
        if getent group daharness >/dev/null 2>&1; then
            chgrp daharness /run/daharness 2>/dev/null || true
            chmod 0770 /run/daharness 2>/dev/null || true
        fi
        echo "daharness: systemd not detected — using init.d scripts"
        echo "  start services: sudo /etc/init.d/daharness start"
        echo "  start kernel:   sudo /etc/init.d/daharness-kernel start"
    fi
    unset _SRC
fi

# ────────────────────────────────────────────────────────────────────── #
# rust upgrade lane hint (0.1.x -> 0.2.0: python/c -> python/rust)       #
# ────────────────────────────────────────────────────────────────────── #
# The 0.2.0 deb ships the three rust crates as SOURCE under
# /usr/share/daharness/rust/ — deliberately unbuilt (the install stays
# network-isolated; the deb build lane has no cargo). For users online,
# building + verifying + running the rust sidecar lane is ONE command:
# see daharness-rust(1). Echoed on UPGRADES ONLY (postinst $2 is the
# previously installed version); a fresh install learns it from
# daharness-rust status / the man page instead.
if [ -n "${2:-}" ]; then
    echo "daharness: rust crate sources shipped to /usr/share/daharness/rust/ (scratch, pcap, brain)"
    echo "daharness:   upgrade lane: 'daharness-rust status' probes; 'sudo daharness-rust all' builds + tests it (network)"
    echo "daharness:   nothing is built or replaced automatically — the python service lanes are unchanged"
fi

#DEBHELPER#