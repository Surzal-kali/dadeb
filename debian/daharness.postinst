#!/bin/sh
set -e

# Dedicated system identity (ledger decision: profiles, UMask 0007 group
# sharing). StateDirectory= in the unit owns /var/lib/daharness at start.
if ! getent passwd daharness >/dev/null; then
    adduser --system --group --home /var/lib/daharness \
        --shell /usr/sbin/nologin daharness
fi

# Shared-state PERMISSIONS: a group-membership grant alone does not make
# the state shareable — adduser's own SYS_DIR_MODE (0755) ships the root
# without group write, and without setgid (2770) every file an operator's
# shell creates lands operator-owner:operator-group (kali:kali), invisible
# to the service lanes. Shaping happens HERE (also on upgrades, for legacy
# trees) and in the units' StateDirectoryMode=2770 (re-asserted on every
# start; a plain 0750 there would strip the setgid). Dirs under a setgid
# root inherit the bit, so the tree stays group-shared as both lanes
# create things — proven live (setgid dir gid inheritance, 2026-10-20).
STATE_ROOT=/var/lib/daharness
if [ -d "$STATE_ROOT" ]; then
    if [ "$(stat -c %U "$STATE_ROOT" 2>/dev/null)" != "daharness" ]; then
        chown -R daharness:daharness "$STATE_ROOT"
        echo "daharness: reconciled $STATE_ROOT ownership to daharness:daharness (legacy tree)"
    fi
else
    mkdir -p "$STATE_ROOT"
    chown daharness:daharness "$STATE_ROOT"
    echo "daharness: created $STATE_ROOT (first install — scope seeding below now applies)"
fi
chown daharness:daharness "$STATE_ROOT"
chmod 2770 "$STATE_ROOT"

# Ghost-uid reconcile (2026-10-21 VM round-trip): dpkg purge keeps
# /var/lib/daharness (operator work product), but dpkg ALSO deletes the
# system user — so a reinstall mints a NEW uid under the SAME state root.
# The tree's deep dirs (chroma/, .cache/, .config/, ids.db, ...) keep the
# OLD uid, which now maps to nothing. systemd's StateDirectory= only
# re-asserts the TOP dir (daharness:daharness 2770) on every start, so the
# wrong-owner subtree survives untouched: observed live — chroma opened its
# persisted sqlite under ghost-uid ownership and panicked with "attempt to
# write a readonly database" 31s after every spawn (pyo3 PanicException),
# wait_for_chroma burned its full budget on the corpse, and the gateway
# then died on the ToolRegistry handshake. find-chown the whole tree: a
# reinstall is exactly the moment ghost uids exist; chowning operator
# files back to the (re-minted) daharness identity is the healing the
# kept-state doctrine requires. Best effort — never fail the install.
find "$STATE_ROOT" -xdev \( ! -user daharness -o ! -group daharness \) \
    -exec chown daharness:daharness {} + 2>/dev/null || true

# Analysis drop lanes (r2 binaries/ + jadx apk/ with its decompiled/ workspaces):
# operator content, so they live in the STATE root alongside scope/ — not the
# read-only package tree the tools resolve their old code-root defaults from.
# The tool modules resolve them via WORKSPACE_ROOT; mkdir-if-missing so
# upgrades repair legacy trees too. 2770 setgid keeps the service lane and
# group-member operators co-writing (same shape the scope/ seeding uses).
for _LANE in binaries apk; do
    if [ ! -d "$STATE_ROOT/$_LANE" ]; then
        install -d -m 2770 "$STATE_ROOT/$_LANE" 2>/dev/null || true
    fi
    chown daharness:daharness "$STATE_ROOT/$_LANE" 2>/dev/null || true
    chmod 2770 "$STATE_ROOT/$_LANE" 2>/dev/null || true
    echo "daharness: drop lane ready at $STATE_ROOT/$_LANE (binaries/APK analysis targets go there)"
done
unset _LANE

# Legacy-tree file MODES: UMask=0007 in the units only shapes files created
# from that unit onward; a state file an older run made under a tighter
# umask (live 2026-10-20: ids.db 0640) stays group-read-only — the
# operator's SQLite write then dies with "attempt to write a readonly
# database" even on a 2770 root (SQLite needs the main file group-writable
# for its -wal/-shm dance). Reconcile just the top-level state files to the
# shape the umask now produces. Best effort: 2>/dev/null || true — a
# genuinely unsharable oddity must not fail the install.
find "$STATE_ROOT" -maxdepth 1 -type f ! -perm -g+w \
    -exec chmod g+rw {} + 2>/dev/null || true

# Shared-state access provisioning: the state root and brain socket are
# group-shared by design (UMask 0007, RuntimeDirectoryMode=0770), and the
# group has no members unless we grant them — a fresh install where the
# operator's own account cannot see the shared state leaves half the
# shared-state pitch dead on arrival. sudo-group members are already
# root-equivalent, so granting them the daharness group adds no privilege;
# other operators opt in with `sudo usermod -aG daharness <user>`.
if getent group daharness >/dev/null; then
    GRANTED=""
    for _U in $(getent group sudo | cut -d: -f4 | tr ',' ' '); do
        [ -n "$_U" ] || continue
        id -nG "$_U" 2>/dev/null | grep -qw daharness && continue
        if usermod -aG daharness "$_U" >/dev/null 2>&1; then
            GRANTED="$GRANTED $_U"
        fi
    done
    if [ -n "$GRANTED" ]; then
        echo "daharness: granted the daharness group (state + brain socket access) to sudo member(s):$GRANTED"
        echo "  group membership applies on next login or \`newgrp daharness\`"
    fi
fi

# Scope-manifest provisioning: a temp local-lab scope should be editable-off-
# rip, not reconstructed from code knowledge. Seed the lab template into the
# state root's scope/ dir (daharness-owned 2770 setgid so the service lane
# and group-member operators share it; setgid re-groups files created by
# whichever lane writes first). Strictly guarded: an existing
# manifest — operator-customized or re-run — is never stomped.
_TEMPLATE=/usr/share/daharness/examples/scope/lab_local-lab.json
if [ -r "$_TEMPLATE" ]; then
    if mkdir -p /var/lib/daharness/scope; then
        chown daharness:daharness /var/lib/daharness/scope
        # Setgid (2770): operator-authored manifests inherit the daharness
        # group, so the service lane can read them (a 0770 without the bit
        # would strand kali:kali files again).
        chmod 2770 /var/lib/daharness/scope
        if [ ! -e /var/lib/daharness/scope/lab_local-lab.json ]; then
            if install -m 0660 -o daharness -g daharness \
                "$_TEMPLATE" /var/lib/daharness/scope/lab_local-lab.json; then
                echo "daharness: seeded lab scope template at /var/lib/daharness/scope/lab_local-lab.json"
                echo "  edit the subnet/ROE, then arm: python tool_repl.py scope on local-lab --platform lab"
            fi
        fi
    fi
fi
unset _TEMPLATE

# Gateway API key: generate once when the conffile placeholder is still
# empty, so a stock deb never boots an unauthenticated gateway. The
# in-place conffile edit triggers the upgrade prompt ("keep current" — the
# default — preserves the live key); clearing the line + a re-configure
# regenerates it.
if [ -r /etc/daharness/daharness.env ] && \
   grep -q '^GATEWAY_API_KEY=""$' /etc/daharness/daharness.env; then
    if command -v openssl >/dev/null 2>&1; then
        KEY=$(openssl rand -hex 32)
    else
        KEY=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
    fi
    if [ -n "$KEY" ]; then
        sed -i "s|^GATEWAY_API_KEY=.*$|GATEWAY_API_KEY=\"$KEY\"|" /etc/daharness/daharness.env
        echo "daharness: generated GATEWAY_API_KEY into /etc/daharness/daharness.env"
    fi
fi

# Chroma merge (2026-10-20): the standalone chroma unit is retired — the
# daemon launches chroma as a supervised sidecar that reuses (never
# double-spawns) an answering lane. Upgrades from pkg<=4 ship a still-
# RUNNING daharness-chroma.service whose unit file this package no longer
# carries: stop+disable it here, before the sidecar can boot, so the
# zombie cannot keep :9000 (the merged sidecar's reuse-probe would adopt
# it and its Restart= keeps respawning a process systemd no longer
# supervises properly).
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl stop daharness-chroma.service 2>/dev/null || true
    systemctl disable daharness-chroma.service 2>/dev/null || true
    if systemctl is-active daharness-chroma.service >/dev/null 2>&1 || \
       systemctl list-unit-files daharness-chroma.service 2>/dev/null | grep -q daharness-chroma; then
        echo "daharness: retired daharness-chroma.service (chroma is a daemon sidecar now)"
    fi
fi

# Runtime units must be RE-READ by the running systemd before the next
# (re)start: every service start re-asserts RuntimeDirectoryMode /
# StateDirectoryMode, and a stale systemd unit cache re-applies the OLD
# shapes over whatever this postinst just laid down (observed live
# 2026-10-20: the upgrade wrote StateDirectoryMode=2770 to disk while the
# running cache still held 0750, so the next daemon start reset the root
# to 0750 — every on-disk permission patch looked "not landed" at boot
# time). dh_installsystemd normally triggers the reload; this is the
# belt-and-braces last word so a unit-file change can never be stomped by
# a restart that never saw it.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload 2>/dev/null || true
fi

#DEBHELPER#