# Sketch — /etc/daharness/daharness.env (packaged config; conffile).
# This is the profile stub: file-location knobs set for the SYSTEM profile,
# user-profile deltas commented. Everything else follows .env.example
# (shipped at /usr/share/daharness/.env.example; document, don't duplicate).

# --- File locations (system profile) — the out-of-the-box defaults ---
# State root: run/, scope/, engagement/, ids.db, scratch.db, cookie_jar.db,
# .memory/, dropbox/, findings_md/ all resolve under this.
WORKSPACE_ROOT=/var/lib/daharness
# Tool discovery deliberately ignores this knob — it walks the packaged CODE
# tree (/usr/share/daharness) via FRAMEWORK_ROOT, so `daharness-index` mints
# the shipped tools regardless of where state is pinned.
# Brain UDS: group-shareable via RuntimeDirectory + UMask=0007 in the unit.
# Socket resolution becomes writability-aware on the dev-tree default change;
# /run/daharness is guaranteed group-writable by RuntimeDirectoryMode=0770.
# Operator shells get these two knobs from /etc/profile.d/daharness.sh (the
# wrappers source it for non-login runs); the deb grants the daharness group
# to sudo-group members at install so shared state is visible without manual
# group surgery.
BRAIN_SOCKET=/run/daharness/brain.sock

# --- API gateway (bind + auth posture, see daharness-safety(7)) ---
# Bind stays loopback by default (ZAP pattern: 0.0.0.0 is a conscious
# widening). GATEWAY_API_KEY arms X-API-Key/Bearer auth over REST + /mcp;
# left empty, postinst generates a random key here on install (reinstall
# or `dpkg --configure daharness` regenerates a cleared line; the upgrade
# conffile prompt's default "keep current" preserves a live key).
GATEWAY_HOST=127.0.0.1
GATEWAY_API_KEY=""

# --- User profile deltas (export these in your shell; they win over the
#     profile.d default — no conffile edits needed, the units keep theirs) ---
# The knobs below are NOT exported by this file into shells automatically —
# /etc/profile.d/daharness.sh fills exactly WORKSPACE_ROOT and BRAIN_SOCKET
# for shells that don't carry them (the wrappers source it for non-login
# runs). To run a user-profile lane instead, export your own values — they
# win over the profile default:
# WORKSPACE_ROOT=$HOME/.local/state/daharness
# BRAIN_SOCKET=$XDG_RUNTIME_DIR/daharness/brain.sock

# --- Board auth (scope lane; units read these via EnvironmentFile) ------------
# Shipped empty on purpose. Fill locally, then: chmod 0600 /etc/daharness/daharness.env
#   H1_API_USERNAME=      H1_API_TOKEN=        (HackerOne Basic auth; without
#     them H1 tools return auth_required — the hacktivity feed stays public)
#   INTIGRITI_USERNAME=   INTIGRITI_API_TOKEN= (Intigriti researcher PAT)
#   BUGCROWD_USERNAME=                         (public API; falls back to H1 user)
#   RESEARCHER_USERNAME=                       (fallback handle, other platforms)
# Documented in daharness.env(5); dev-tree equivalent rows live in .env.example.

# --- Embedding model (tool registry + memory lanes; loopback/LAN only,
#     never cloud). No chat model is read by this headless build: the
#     driving LLM is external (Open WebUI / gateway client). ---
EMBED_MODEL=""
OLLAMA_BASE_URL=""

# --- OOB collaborator ports: default 80/443/53 requires root; the rootless
# system profile retunes instead (see listeners/collaborator.py docstring) ---
# COLLAB_HTTP_PORT=8080
# COLLAB_DNS_PORT=5353

# --- Engagement-Postgres lane (optional; daharness-pg(1)) ---
# No Postgres server ships with the deb: the journal/evidence lane runs on
# the SQLite stores until an operator turns PG on. `sudo apt install
# postgresql` then `sudo daharness-pg init` provisions a dedicated cluster
# ('daharness', port 5433, msfdb's main cluster on 5432 untouched), creates
# the harness db + per-lane roles, and writes the resolved knobs to
# /etc/daharness/pg.env — picked up by the units via EnvironmentFile=- and
# sourceable by operator shells for the REPL. This file carries NO Postgres
# knobs, commented or otherwise — a commented set here reads exactly like
# the live credential set and sent an extension connect to a password that
# does not exist (observed on a pkg6 deb 2026-10-20). To bind the lane to a
# server daharness-pg did NOT provision, edit pg.env (an explicit
# HARNESS_DB_HOST wins over the built-in candidate list) or export the
# HARNESS_DB_* vars in the shell that runs the harness.