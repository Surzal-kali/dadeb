#!/bin/sh
### BEGIN INIT INFO
# Provides:          daharness
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: daharness security framework services
# Description:       Brain sidecar, OWASP ZAP, MSF MCP, API gateway.
#                    systemd-less fallback (NetHunter chroot, init.d hosts).
### END INIT INFO
#
# This script is the init.d fallback for hosts WITHOUT systemd — Kali
# NetHunter chroots (the Kali Services tab drives /etc/init.d/), WSL1,
# and any systemd-less box. When systemd IS present, dh_installsystemd
# owns the units and this script is inert (postinst only installs it on
# the non-systemd lane). The wrapper it launches
# (/usr/bin/daharness -> bootstrap.py --daemon) is the same entry point
# the systemd unit's ExecStart hits, so the daemon behavior is identical
# regardless of supervisor.

set -e

DAEMON=/usr/bin/daharness
NAME=daharness
PIDFILE=/var/run/daharness/${NAME}.pid
ENVFILE=/etc/daharness/daharness.env
RUNDIR=/var/run/daharness

# Load profile knobs (WORKSPACE_ROOT, BRAIN_SOCKET, GATEWAY_*, etc.) —
# mirrors the systemd unit's EnvironmentFile=. /etc/profile.d/daharness.sh
# is for login shells; this is the service lane.
if [ -r "$ENVFILE" ]; then
    set -a
    . "$ENVFILE"
    set +a
fi

mkdir -p "$RUNDIR" 2>/dev/null || true
# /run/daharness is the brain.sock home — systemd's RuntimeDirectory makes
# this on the systemd lane; on init.d we mkdir it ourselves (no
# RuntimeDirectory here). Group-shareable so operator CLIs reach the socket.
if getent group daharness >/dev/null 2>&1; then
    chgrp daharness "$RUNDIR" 2>/dev/null || true
    chmod 0770 "$RUNDIR" 2>/dev/null || true
fi

. /lib/lsb/init-functions

# Real health probe — connect to the Brain UDS. The pidfile can lag the
# actual process state on init.d lanes: start-stop-daemon --background +
# an exec'ing wrapper leaves the pidfile pointing at a PID that may have
# been reaped while the python parent serving the socket is still very
# much alive (observed on Parrot-WSL 2026-10-25: `service status` reported
# dead while framework_doctor said alive). Mirror framework_status.
# _check_unix_socket: a real connect(), not Path.exists() (a stale socket
# file passes the file test but bounces every connect). Returns 0 = serving,
# non-zero = down / no probe tool (falls through to the dead report).
_status_health() {
    _SOCK="${BRAIN_SOCKET:-/run/daharness/brain.sock}"
    [ -S "$_SOCK" ] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$_SOCK" <<'PY' 2>/dev/null
import socket, sys
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
PY
        return $?
    elif command -v nc >/dev/null 2>&1; then
        nc -U -w 2 "$_SOCK" </dev/null >/dev/null 2>&1
        return $?
    fi
    return 1
}

case "$1" in
    start)
        # Mirror systemd's "start on an active unit is a no-op" semantics:
        # if the Brain UDS is already serving, don't double-launch (which
        # would trip bootstrap's _prelaunch_guard with a confusing "failed"
        # — observed on Parrot-WSL 2026-10-25 when a stale root-run daemon
        # from before an upgrade kept the socket up while the pidfile was
        # dead). Tell the operator to use `restart` for a fresh launch.
        if _status_health >/dev/null 2>&1; then
            log_daemon_msg "Starting $NAME" "$DAEMON"
            log_progress_msg "already serving (Brain socket up)"
            log_end_msg 0
            log_success_msg "$NAME is already running — use '$0 restart' for a fresh launch"
            exit 0
        fi
        # start needs real root: --chuid drops privileges (setuid from a
        # non-root caller is EPERM) and the crash-log redirect below runs
        # with the CALLER's privileges — a non-root `service daharness start`
        # used to die with a raw shell "Permission denied" on the root-owned
        # log before s-s-d even ran (observed 2026-10-25). One honest line
        # beats the EACCES noise; LSB exit 4 = insufficient privilege.
        # (The already-serving no-op above stays non-root callable — it
        # only probes.)
        if [ "$(id -u)" != "0" ]; then
            log_failure_msg "$NAME start must run as root: sudo service daharness start"
            exit 4
        fi
        log_daemon_msg "Starting $NAME" "$DAEMON"
        # --daemon: start services (Brain, ZAP, MSF, gateway) and wait for
        # SIGTERM — same as the systemd unit's ExecStart.
        # --chuid daharness:daharness: drop to the service identity to match
        # the systemd unit's User=/Group=. The env file is sourced above (as
        # root, so a 0600 conffile still works), the umask is set, and
        # /run/daharness is mkdir'd + chgrp'd before the drop — so the
        # daharness user inherits a ready runtime dir. Without this the
        # init.d lane ran the entire stack as root, writing root-owned files
        # into the setgid state tree and breaking the service-user-owns-
        # its-state invariant the postinst's ghost-uid reconcile maintains.
        # stderr capture: --background swallows the child's stdout/stderr
        # (s-s-d hardcodes the detached child's stdio to /dev/null — the
        # shell's >> below only captures s-s-d's OWN output, which is why a
        # python crash showed up as a silent "failed" with an empty log).
        # s-s-d >= 1.20.6 has -O/--output: it opens the file ITSELF (as
        # root, pre-chuid — verified in dpkg 1.22.22 do_start(): open()
        # happens before setgid/setuid, then dup2(1)/dup2(2)) and points
        # the child's stdout+stderr at it, so the log works even with a
        # root-owned /var/log file and the daharness drop. start-stop-daemon's
        # own errors still land there via the shell redirect.
        _CRASHLOG=/var/log/daharness-start.log
        # --chdir: parity with the systemd unit's WorkingDirectory=/var/lib/
        # daharness. Without it s-s-d chdirs to / (its documented default),
        # and msfrpcd's Rails boot then resolves its app root via
        # find_root_with_flag("config.ru", ..., Dir.pwd) -> "/" — no config.ru
        # exists up the tree — so add_lib_to_load_path! unshifts /lib into
        # $LOAD_PATH and bootsnap's load-path scan walks ALL of /usr/lib,
        # dying on the first unreadable dir (WSL: the kernel-modules
        # lost+found, root:root 0700 -> EACCES, msfrpcd dead before bind).
        # Observed live on Parrot-WSL 2026-10-25; reproduced with
        # `cd / && ruby msfrpcd --help` (crash) vs `cd /var/lib/daharness &&
        # ruby msfrpcd --help` (clean boot). s-s-d chdirs pre-chuid, and
        # root passes the 2770 state dir's gate fine.
        if start-stop-daemon --start --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" \
            --output "$_CRASHLOG" --chdir /var/lib/daharness \
            --chuid daharness:daharness -- --daemon >>"$_CRASHLOG" 2>&1; then
            log_end_msg 0
        else
            log_end_msg 1
            log_failure_msg "  crash log: $_CRASHLOG (cat it for the python traceback)"
        fi
        ;;
    stop)
        # Killing the daemon (root-owned since the --chuid drop) is a root
        # operation: a non-root stop silently no-ops (every kill EPERMs and
        # the || true guards swallow it) while still reporting success —
        # worse than refusing. Same LSB-4 refusal as start.
        if [ "$(id -u)" != "0" ]; then
            log_failure_msg "$NAME stop must run as root: sudo service daharness stop"
            exit 4
        fi
        log_daemon_msg "Stopping $NAME"
        # Pidfile stop first (the happy path — python wrote its own PID).
        start-stop-daemon --stop --pidfile "$PIDFILE" --retry 30 2>/dev/null || true
        # Pidfile-stale sweep: on init.d the pidfile can lag the real
        # process state (start-stop-daemon --background + an exec'ing
        # wrapper is racy, and a previous root-run daemon from before an
        # upgrade leaves the socket up with a dead pidfile PID). pgrep the
        # actual bootstrap.py --daemon process and reap stragglers so a
        # subsequent `start` doesn't trip _prelaunch_guard. Match across
        # all users (a legacy root-run daemon is exactly the case we're
        # healing); the script itself runs as root so the kill is allowed.
        _STRAGGLERS=$(pgrep -f "/usr/share/daharness/bootstrap.py .*--daemon" 2>/dev/null || true)
        if [ -n "$_STRAGGLERS" ]; then
            kill $_STRAGGLERS 2>/dev/null || true
            sleep 2 2>/dev/null || true
            kill -9 $_STRAGGLERS 2>/dev/null || true
        fi
        unset _STRAGGLERS
        # Clean the socket too: a stale brain.sock file passes is_socket but
        # bounces every connect, which would make the next start's
        # _status_health probe (and framework_doctor) report down even after
        # the daemon is gone. The Brain unlinks on clean shutdown; this is
        # the crash-path backstop.
        rm -f "${BRAIN_SOCKET:-/run/daharness/brain.sock}" 2>/dev/null || true
        rm -f "$PIDFILE" 2>/dev/null || true
        log_end_msg 0
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        _PID=""
        [ -f "$PIDFILE" ] && _PID=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$_PID" ] && kill -0 "$_PID" 2>/dev/null; then
            log_success_msg "$NAME is running (pid $_PID)"
            exit 0
        fi
        # Pidfile stale or missing — probe the Brain UDS directly. A real
        # connect catches the "dead per pidfile, alive per socket" gap that
        # pure pidfile status reports as dead on init.d lanes.
        if _status_health >/dev/null 2>&1; then
            log_success_msg "$NAME is serving (Brain socket up; pidfile stale)"
            exit 0
        fi
        log_failure_msg "$NAME is not running"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0