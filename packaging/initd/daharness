#!/bin/sh
### BEGIN INIT INFO
# Provides:          daharness
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: daharness security framework services
# Description:       Brain sidecar, OWASP ZAP, MSF MCP, API gateway.
#                    systemd-less fallback (NetHunter chroot, init.d hosts).
### END INIT INFO
#
# This script is the init.d fallback for hosts WITHOUT systemd — Kali
# NetHunter chroots (the Kali Services tab drives /etc/init.d/), WSL1,
# and any systemd-less box. When systemd IS present, dh_installsystemd
# owns the units and this script is inert (postinst only installs it on
# the non-systemd lane). The wrapper it launches
# (/usr/bin/daharness -> bootstrap.py --daemon) is the same entry point
# the systemd unit's ExecStart hits, so the daemon behavior is identical
# regardless of supervisor.

set -e

DAEMON=/usr/bin/daharness
NAME=daharness
PIDFILE=/var/run/daharness/${NAME}.pid
ENVFILE=/etc/daharness/daharness.env
RUNDIR=/var/run/daharness

# Load profile knobs (WORKSPACE_ROOT, BRAIN_SOCKET, GATEWAY_*, etc.) —
# mirrors the systemd unit's EnvironmentFile=. /etc/profile.d/daharness.sh
# is for login shells; this is the service lane.
if [ -r "$ENVFILE" ]; then
    set -a
    . "$ENVFILE"
    set +a
fi

mkdir -p "$RUNDIR" 2>/dev/null || true
# /run/daharness is the brain.sock home — systemd's RuntimeDirectory makes
# this on the systemd lane; on init.d we mkdir it ourselves (no
# RuntimeDirectory here). Group-shareable so operator CLIs reach the socket.
if getent group daharness >/dev/null 2>&1; then
    chgrp daharness "$RUNDIR" 2>/dev/null || true
    chmod 0770 "$RUNDIR" 2>/dev/null || true
fi

. /lib/lsb/init-functions

# Real health probe — connect to the Brain UDS. The pidfile can lag the
# actual process state on init.d lanes: start-stop-daemon --background +
# an exec'ing wrapper leaves the pidfile pointing at a PID that may have
# been reaped while the python parent serving the socket is still very
# much alive (observed on Parrot-WSL 2026-10-25: `service status` reported
# dead while framework_doctor said alive). Mirror framework_status.
# _check_unix_socket: a real connect(), not Path.exists() (a stale socket
# file passes the file test but bounces every connect). Returns 0 = serving,
# non-zero = down / no probe tool (falls through to the dead report).
_status_health() {
    _SOCK="${BRAIN_SOCKET:-/run/daharness/brain.sock}"
    [ -S "$_SOCK" ] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$_SOCK" <<'PY' 2>/dev/null
import socket, sys
try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        s.connect(sys.argv[1])
except OSError:
    sys.exit(1)
PY
        return $?
    elif command -v nc >/dev/null 2>&1; then
        nc -U -w 2 "$_SOCK" </dev/null >/dev/null 2>&1
        return $?
    fi
    return 1
}

case "$1" in
    start)
        log_daemon_msg "Starting $NAME" "$DAEMON"
        # --daemon: start services (Brain, ZAP, MSF, gateway) and wait for
        # SIGTERM — same as the systemd unit's ExecStart.
        # --chuid daharness:daharness: drop to the service identity to match
        # the systemd unit's User=/Group=. The env file is sourced above (as
        # root, so a 0600 conffile still works), the umask is set, and
        # /run/daharness is mkdir'd + chgrp'd before the drop — so the
        # daharness user inherits a ready runtime dir. Without this the
        # init.d lane ran the entire stack as root, writing root-owned files
        # into the setgid state tree and breaking the service-user-owns-
        # its-state invariant the postinst's ghost-uid reconcile maintains.
        if start-stop-daemon --start --background --make-pidfile \
            --pidfile "$PIDFILE" --exec "$DAEMON" \
            --chuid daharness:daharness -- --daemon 2>/dev/null; then
            log_end_msg 0
        else
            log_end_msg 1
        fi
        ;;
    stop)
        log_daemon_msg "Stopping $NAME"
        if start-stop-daemon --stop --pidfile "$PIDFILE" --retry 30 2>/dev/null; then
            log_end_msg 0
        else
            log_end_msg 1
        fi
        rm -f "$PIDFILE" 2>/dev/null || true
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        _PID=""
        [ -f "$PIDFILE" ] && _PID=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$_PID" ] && kill -0 "$_PID" 2>/dev/null; then
            log_success_msg "$NAME is running (pid $_PID)"
            exit 0
        fi
        # Pidfile stale or missing — probe the Brain UDS directly. A real
        # connect catches the "dead per pidfile, alive per socket" gap that
        # pure pidfile status reports as dead on init.d lanes.
        if _status_health >/dev/null 2>&1; then
            log_success_msg "$NAME is serving (Brain socket up; pidfile stale)"
            exit 0
        fi
        log_failure_msg "$NAME is not running"
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0