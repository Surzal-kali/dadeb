# Sketch — system profile, daharness daemon (Brain + ZAP + MSF MCP + API gateway)
# Carries over scripts/daharness.service semantics; retargeted for the package
# layout. Hand to dh_installsystemd; final paths verified on the VM smoke.
[Unit]
Description=daharness security framework services (Brain, ZAP, MSF MCP, API gateway)
Documentation=file:///usr/share/doc/daharness/README.md
After=network-online.target daharness-chroma.service
Wants=network-online.target daharness-chroma.service

[Service]
Type=simple
User=daharness
Group=daharness
UMask=0007
# /run/daharness (tmpfs) — brain.sock home; group-shareable to operator CLIs
RuntimeDirectory=daharness
RuntimeDirectoryMode=0770
# /var/lib/daharness — WORKSPACE_ROOT for the system profile. 2770:
# group-write + SETGID so files the operator shell creates at the root
# (ids.db, cookie_jar.db) inherit the daharness group — a plain r-x mode
# like 0750 ships a read-only-for-operators state root and the setgid
# cascade never starts (postinst lays the same shape down on install).
StateDirectory=daharness
StateDirectoryMode=2770
# Conffile wires the profile knobs (WORKSPACE_ROOT, BRAIN_SOCKET,
# GATEWAY_*, CHROMA_PORT) into the unit environment — the earlier
# Environment=DAHARNESS_ENV form was inert (no code reads that var; only
# <tree>/.env is loaded by bootstrap, and the deb ships no .env).
# Wired 2026-10-20 after the fresh-deb smoke showed the daemon resolving
# state paths against the root-owned code checkout instead of the
# StateDirectory the unit itself was provisioning.
EnvironmentFile=/etc/daharness/daharness.env
# Optional engagement-Postgres lane: absent file = lane stays silently off
# (`daharness-pg init` generates /etc/daharness/pg.env); tolerant so the
# fresh-deb experience is unchanged.
EnvironmentFile=-/etc/daharness/pg.env
WorkingDirectory=/var/lib/daharness
# Chroma boots in ~2-5s; a short tolerant head start (disabled chroma unit
# never blocks the daemon — the registry's server-connection failure is
# contained today and boots the stack degraded, journal-proven).
ExecStartPre=/bin/sh -c 'i=0; while [ "$i" -lt 20 ]; do ss -ltnH 2>/dev/null | grep -q ":${CHROMA_PORT:-9000} " && exit 0; sleep 1; i=$((i+1)); done; exit 0'
ExecStart=/usr/bin/daharness --daemon
# bootstrap handles SIGTERM and reaps its sidecars; don't kill the children first
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# Privileged lanes stay OFF the baseline (root/capability profiles are operator
# opt-ins). Drop-in override shape, documented not shipped:
#   /etc/systemd/system/daharness.service.d/privileged.conf
#     [Service]
#     AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
#     CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target