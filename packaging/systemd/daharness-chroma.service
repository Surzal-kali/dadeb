# System profile, vendored ChromaDB server — tool registry backend.
# The registry (daharness/registry.py) dials chromadb.HttpClient at
# CHROMA_HOST/CHROMA_PORT (default localhost:9000); on the dev tree that
# server is the dockered compose `chroma` container. The deb lane carries
# no docker — the vendored closure itself serves it over the chroma CLI.
[Unit]
Description=daharness vendored ChromaDB server (tool registry backend)
Documentation=file:///usr/share/doc/daharness/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=daharness
Group=daharness
UMask=0007
# Shared StateDirectory with the daemon unit (same identity) — the
# persistence path is /var/lib/daharness/chroma.
StateDirectory=daharness
# 2770 = group-write + setgid, matching the daemon unit (setgid is the
# group-share inheritance point; 0750 left the group read-only).
StateDirectoryMode=2770
EnvironmentFile=/etc/daharness/daharness.env
ExecStart=/usr/bin/daharness-chroma
Restart=on-failure
RestartSec=5
KillMode=process
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target