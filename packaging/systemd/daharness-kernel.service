# Sketch — system profile, Jupyter tool kernel (tool_repl.py --kernel)
# Carries over scripts/daharness-kernel.service semantics; retargeted for the
# package layout. Shares /run/daharness/brain.sock with the daemon unit.
[Unit]
Description=daharness tool kernel (tool_repl.py --kernel)
Documentation=file:///usr/share/doc/daharness/README.md
After=network.target

[Service]
Type=simple
User=daharness
Group=daharness
UMask=0007
RuntimeDirectory=daharness
RuntimeDirectoryMode=0770
# Preserve the tmpfs across restarts — same reason as the daemon unit
# (workbench lanes bind /run/daharness PATH-identically).
RuntimeDirectoryPreserve=restart
StateDirectory=daharness
# 2770 = group-write + setgid: group-share inheritance for operator-written
# state (see the daemon unit's comment; 0750 left the group read-only).
StateDirectoryMode=2770
# Kernel connection file + JUPYTER_RUNTIME_DIR artifacts are chowned to the
# attaching operator by tool_repl.py (see _kernel_owner()); this receives the
# uid/name. Multi-operator: the group share is the fallback.
Environment=DAHARNESS_KERNEL_OWNER=""
# Conffile wires the profile knobs (WORKSPACE_ROOT, BRAIN_SOCKET) — the
# old Environment=DAHARNESS_ENV/BRAIN_SOCKET lines were inert/duplicate;
# chroma already read this file via EnvironmentFile (wired 2026-10-20).
EnvironmentFile=/etc/daharness/daharness.env
# Optional engagement-Postgres lane (`daharness-pg init` generates it);
# tolerant = REPL kernel journals to the SQLite stores until the lane is up.
EnvironmentFile=-/etc/daharness/pg.env
WorkingDirectory=/var/lib/daharness
ExecStart=/usr/bin/daharness-kernel
# No tty: the kernel arms the SIGTERM/shutdown_request exit path
StandardInput=null
StandardOutput=journal
StandardError=journal
# Framework background jobs (nmap/masscan/ffuf/...) spawn detached
# (start_new_session=True) so orphaned scans survive harness death; killing
# only the main process on stop preserves that semantic.
KillMode=process
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target